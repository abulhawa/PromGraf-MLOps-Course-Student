{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Model performance",
      "folder": "Model monitoring",
      "interval": "1m",
      "rules": [
        {
          "uid": "model-accuracy-low",
          "title": "ModelAccuracyLow",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "$GRAFANA_PROMETHEUS_UID",
              "model": {
                "expr": "model_accuracy_score{job=\"news_classifier_api\"}",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.8
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Latest model accuracy is below 80%."
          },
          "isPaused": false
        },
        {
          "uid": "prediction-category-dominance",
          "title": "PredictionCategoryDominance",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "$GRAFANA_PROMETHEUS_UID",
              "model": {
                "expr": "sum by (category) (increase(predictions_by_category_total{job=\"news_classifier_api\"}[1h])) / scalar(sum(increase(predictions_by_category_total{job=\"news_classifier_api\"}[1h])) > 0)",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A category accounts for more than 50% of predictions in the last hour."
          },
          "isPaused": false
        }
      ]
    }
  ]
}
